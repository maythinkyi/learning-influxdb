# Initialize InfluxDB on startup
DOCKER_INFLUXDB_INIT_MODE=setup

## Environment variables used during the setup and operation of the stack
#

# Primary InfluxDB admin/superuser credentials
#
DOCKER_INFLUXDB_INIT_USERNAME=maythinkyi
DOCKER_INFLUXDB_INIT_PASSWORD=password 
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=3f9df014a30a4501edab62bb499a0c14 

# Primary InfluxDB organization & bucket definitions
# 
DOCKER_INFLUXDB_INIT_ORG=influxdb_learning 
DOCKER_INFLUXDB_INIT_BUCKET=noaa

# Primary InfluxDB bucket retention period
#
# NOTE: Valid units are nanoseconds (ns), microseconds(us), milliseconds (ms)
# seconds (s), minutes (m), hours (h), days (d), and weeks (w).
DOCKER_INFLUXDB_INIT_RETENTION=4d 

# InfluxDB port definition
INFLUXDB_PORT=8087

# Grafana port definition
GRAFANA_PORT=3001

INFLUX_URI=http://localhost:8087
INFLUX_TOKEN=3f9df014a30a4501edab62bb499a0c14
INFLUX_ORG=influxdb_learning
INFLUX_MEASUREMENT=average_temperature
INFLUX_BUCKET=noaa